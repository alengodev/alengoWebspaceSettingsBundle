{
    "name": "alengo/alengo-webspace-settings-bundle",
    "type": "sulu-bundle",
    "description": "Webspace Settings Bundle",
    "keywords": [
        "sulu",
        "suluCms",
        "content",
        "entity"
    ],
    "homepage": "https://github.com/alengodev/AlengoWebspaceSettingsBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "ext-iconv": "*",
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/serializer": "^7.2",
        "symfony/twig-bundle": "^7.2"
    },
    "require-dev": {
        "jackalope/jackalope-doctrine-dbal": "^1.10 || ^2.0",
        "symfony/browser-kit": "^7.2",
        "symfony/console": "^7.2"
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyze"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\Bundle\\AlengoWebspaceSettingsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alengo\\Bundle\\AlengoWebspaceSettingsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
